# Copy to backend/.env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# PostgreSQL as the application role (NOT a superuser: superusers bypass row-level security)
DATABASE_URL=postgresql://app_user:app_user@127.0.0.1:5432/passport
# Storage: "local" for development, "azure" for Azure Blob Storage (or Azurite)
FILE_STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=.storage
AZURE_STORAGE_CONNECTION_STRING=
# Upload limits in MB (provisional until OQ-31 is decided)
MAX_UPLOAD_MB_STEP=200
MAX_UPLOAD_MB_DWG=100
MAX_UPLOAD_MB_PDF=100
# Token lifetimes in minutes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_MINUTES=480
# CAD worker: role to claim jobs across tenants (empty if the worker logs in as app_worker)
WORKER_DB_ROLE=
# Download/preview links are single-use; this is how long an unused link stays valid
DOWNLOAD_LINK_SECONDS=120
# Invitations: web address for acceptance links. INVITATION_LINK_IN_RESPONSE shows the link to the inviting admin
# as a development aid; it is ignored (always off) unless DJANGO_DEBUG=true.
WEB_BASE_URL=http://127.0.0.1:5173
# Address for download/preview links returned by the API (only needed behind a proxy that changes host or port)
# PUBLIC_BASE_URL=
INVITATION_DAYS=7
INVITATION_LINK_IN_RESPONSE=true
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# --- e-mail (registration, invitations, password reset). For real delivery use the SMTP backend and fill in the server;
# put the real password only in your own .env (never commit it), in single quotes if it contains # $ % ! or spaces.
# Port 465 = EMAIL_USE_SSL=true, port 587 = EMAIL_USE_TLS=true. With real email set INVITATION_LINK_IN_RESPONSE=false.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.example.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=true
# EMAIL_USE_TLS=false
# EMAIL_HOST_USER=notifications@example.com
# EMAIL_HOST_PASSWORD='<your mailbox password>'
# DEFAULT_FROM_EMAIL=notifications@example.com
# Self-registration from the sign-in page, each approved by an Aries Admin on the Registrations page:
# "Register your company" (new client company) and "Request an account" (Aries Engineer, QA or Support)
# PUBLIC_REGISTRATION_ENABLED=true
# Part photographs (JPEG/PNG), provisional limit (OQ-31)
MAX_UPLOAD_MB_IMAGE=20
MAX_IMAGE_PIXELS=60000000
# Sign-in attempts per client IP (default 10/min). Raise only on a local machine running the full E2E suite,
# which signs in more often than a person would, e.g. LOGIN_THROTTLE=200/min. Never raise it in a hosted environment.
LOGIN_THROTTLE=10/min
# Optional log file (rotated, 10 MB x 5); the worker writes <name>-worker.log next to it. One line per API request.
# LOG_FILE=logs/passport.log
