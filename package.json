{
  "name": "passport-platform",
  "private": true,
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "gen:api": "openapi-typescript docs/openapi.yaml -o packages/api-types/src/schema.d.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace web"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "openapi-typescript": "^7.6.1",
    "typescript": "~5.8.3"
  }
}
