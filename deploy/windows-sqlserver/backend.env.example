# C:\DigitalPassport\backend\.env  (read by config/settings.py; keep this file readable by administrators and the service account only)

# --- database (SQL Server)
DB_ENGINE=mssql
DB_HOST=localhost\SQLEXPRESS
DB_NAME=DigitalPassport_Prod
DB_USER=dp_app
DB_PASSWORD=<dp_app password>
DB_DRIVER=ODBC Driver 18 for SQL Server
# local server with a self-signed certificate; remove when SQL Server has a trusted certificate
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONN_MAX_AGE=0

# --- Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=<64+ random characters: python -c "import secrets; print(secrets.token_urlsafe(64))">
DJANGO_ALLOWED_HOSTS=passport.yourcompany.com
WEB_BASE_URL=https://passport.yourcompany.com
LOCAL_STORAGE_ROOT=D:\DigitalPassportData\storage
FILE_STORAGE_BACKEND=local
# Log file (rotated at 10 MB, 5 kept). The worker writes passport-worker.log next to it. One line per API request;
# errors with their reference (req=...) as shown to users. ACCESS_LOG=false turns the request lines off.
LOG_FILE=D:\DigitalPassportData\logs\passport.log
LOG_LEVEL=INFO

# --- e-mail (registration, invitations, password reset) through your SMTP server. Real password only in the server's
# own .env, in single quotes. Port 465 = EMAIL_USE_SSL=true; port 587 = EMAIL_USE_TLS=true.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.yourcompany.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=notifications@yourcompany.com
EMAIL_HOST_PASSWORD='<mailbox password>'
DEFAULT_FROM_EMAIL=notifications@yourcompany.com
# Sign-in page self-registration (client companies and Aries staff accounts), each approved by an Aries Admin
PUBLIC_REGISTRATION_ENABLED=false

# --- features (as tested on SQL Server). External AI stays off: no Gemini key on the server.
FOUR_ROLE_MODEL_ENABLED=true
CLIENT_PART_SUBMISSIONS_ENABLED=true
EDIT_REQUESTS_ENABLED=true
INVENTORY_IMPORT_ENABLED=true
PART_INTELLIGENCE_ENABLED=true
AI_PROVIDER=
AI_CLIENT_ACCESS_ENABLED=true
AI_CLIENT_SHARING_COMPANIES=
ADMIN_WORKSPACE_ENABLED=true
ADMIN_THUMBNAIL_CONSENT_ENABLED=true
ADMIN_THUMBNAIL_PROVENANCE_ENABLED=true
REPORT_COMPANY_NAME=Aries
REPORT_COMPANY_LOCATION=<city, country>

# --- worker only (set in the worker service's environment, not here): WORKER_DB_ROLE=app_worker
